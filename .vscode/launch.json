{
    // La URL de la base (SUPABASE_DB_URL) sale del .env de la raíz (envFile). Para correr
    // todo a la vez, usa en el .env el pooler en modo transacción (puerto 6543 con
    // prepareThreshold=0, ver .env.example). Cada servicio usa un pool de 2 conexiones.
    "configurations": [
        {
            "type": "java",
            "name": "Spring Boot-DemoApplication<demo>",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "mainClass": "com.example.demo.DemoApplication",
            "projectName": "demo",
            "args": "--spring.datasource.hikari.maximum-pool-size=2",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "type": "java",
            "name": "ms-auth (8081)",
            "request": "launch",
            "cwd": "${workspaceFolder}/ms-auth",
            "mainClass": "com.example.msauth.MsAuthApplication",
            "projectName": "ms-auth",
            "args": "--spring.datasource.hikari.maximum-pool-size=2",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "type": "java",
            "name": "ms-perfil (8082)",
            "request": "launch",
            "cwd": "${workspaceFolder}/ms-perfil",
            "mainClass": "com.example.msperfil.MsPerfilApplication",
            "projectName": "ms-perfil",
            "args": "--spring.datasource.hikari.maximum-pool-size=2",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "type": "java",
            "name": "ms-solicitudes (8083)",
            "request": "launch",
            "cwd": "${workspaceFolder}/ms-solicitudes",
            "mainClass": "com.example.mssolicitudes.MsSolicitudesApplication",
            "projectName": "ms-solicitudes",
            "args": "--spring.datasource.hikari.maximum-pool-size=2",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "type": "java",
            "name": "ms-admin-reportes (8084)",
            "request": "launch",
            "cwd": "${workspaceFolder}/ms-admin-reportes",
            "mainClass": "com.example.msadmin.MsAdminReportesApplication",
            "projectName": "ms-admin-reportes",
            "args": "--spring.datasource.hikari.maximum-pool-size=2",
            "envFile": "${workspaceFolder}/.env"
        }
    ],
    "compounds": [
        {
            "name": "Todos los microservicios",
            "configurations": [
                "ms-auth (8081)",
                "ms-perfil (8082)",
                "ms-solicitudes (8083)",
                "ms-admin-reportes (8084)"
            ],
            "stopAll": true
        }
    ]
}
