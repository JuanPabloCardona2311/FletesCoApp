# Variables de entorno requeridas por ms-auth
# Copia este archivo como .env y rellena los valores reales

# URL JDBC de Supabase (formato: jdbc:postgresql://<host>:<puerto>/<dbname>)
SUPABASE_DB_URL=

# Usuario de la base de datos Supabase
SUPABASE_DB_USERNAME=

# Contraseña de la base de datos Supabase
SUPABASE_DB_PASSWORD=

# Secreto para firmar los tokens JWT (mínimo 32 caracteres aleatorios)
JWT_SECRET=
