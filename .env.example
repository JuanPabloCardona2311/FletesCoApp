# Plantilla de variables de entorno para conexion a Supabase
# Copia este archivo a un nuevo archivo llamado .env y coloca tu contrasena real
# Pooler de Supabase en modo transacción (puerto 6543): necesita prepareThreshold=0 y
# permite correr todos los servicios a la vez sin superar el límite de conexiones.
SUPABASE_DB_URL=jdbc:postgresql://<TU_HOST_SUPABASE>:6543/postgres?sslmode=require&prepareThreshold=0
SUPABASE_DB_USERNAME=<TU_USUARIO>
SUPABASE_DB_PASSWORD=<TU_PASSWORD>

# Secreto para firmar los tokens JWT: pídelo por el canal privado del equipo
JWT_SECRET=<TU_JWT_SECRET>
