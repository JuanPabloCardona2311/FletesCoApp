# Plantilla de variables de entorno para conexion a Supabase
# Copia este archivo a un nuevo archivo llamado .env y coloca tu contrasena real
SUPABASE_DB_URL=jdbc:postgresql://aws-0-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.mjowsnxbjeqnpyormvko
SUPABASE_DB_PASSWORD=REPLACE_WITH_YOUR_SUPABASE_PASSWORD

# Secreto para firmar los tokens JWT: pídelo por el canal privado del equipo
JWT_SECRET=REEMPLAZA_CON_EL_VALOR_COMPARTIDO_DEL_EQUIPO

# Supabase Storage para los documentos del conductor (ms-perfil). NO subir los valores reales.
# Panel de Supabase -> Project Settings -> API Keys. Usa la "Secret key" (sb_secret_...);
# nunca la "Publishable key" ni la pongas en el frontend.
SUPABASE_URL=https://AQUI_VA_EL_REF_DEL_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=AQUI_VA_LA_SECRET_KEY_DEL_PROYECTO
