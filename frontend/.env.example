# URLs de los microservicios que consume el frontend.
# Copia este archivo como .env (en esta misma carpeta frontend/) si necesitas
# cambiarlas. Si no existe .env, se usan estos mismos valores por defecto.
# Vite las incrusta al construir (npm run build): cambiarlas exige volver a construir.

VITE_AUTH_URL=http://localhost:8081
VITE_PERFIL_URL=http://localhost:8082
VITE_SOLICITUDES_URL=http://localhost:8083
VITE_ADMIN_URL=http://localhost:8084
